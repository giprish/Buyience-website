# Neon Postgres connection string (required when LEADS_BACKEND_URL is unset)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: when set, /api/leads/* proxies to this base instead of writing to Neon.
# Example: https://api.buyience.com  →  POST {LEADS_BACKEND_URL}/api/leads/demo
# LEADS_BACKEND_URL=
